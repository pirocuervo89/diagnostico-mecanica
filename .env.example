[TEMPLATE]
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
# --- Afiliación (opcional) ---
# Con la etiqueta rellena, TODOS los enlaces de vendedor del catálogo salen ya
# con ?tag=… para cobrar la comisión. Sin ella los enlaces funcionan igual.
# AFFILIATE_ID_AMAZON=
# AFFILIATE_TAG_AMAZON=mietiqueta-21

# --- Afiliación Autodoc (Awin) ---
# Autodoc ES está en Awin con merchant 120163. Sin AWIN_PUBLISHER_ID no se
# generan enlaces de Autodoc, pero el resto de la web funciona igual.
# AWIN_PUBLISHER_ID=
# AWIN_MERCHANT_AUTODOC=120163
# AUTODOC_BASE_URL=https://www.autodoc.es

# --- Afiliación AliExpress y Temu ---
# Cada ficha ofrece también búsqueda en estas dos tiendas. Sin plantilla, el
# botón lleva a la búsqueda normal (útil, pero sin comisión). Con la plantilla
# del panel de afiliados, cada clic pasa a generar comisión.
# AliExpress (portal de afiliados, enlace profundo con {q}):
# ALIEXPRESS_AFF_URL=https://s.click.aliexpress.com/e/_EJEMPLO?q={q}
# Temu (enlace de afiliado; {q} se sustituye por la búsqueda del producto):
# TEMU_AFF_URL=https://temu.to/k/ejemplo?q={q}

# --- Refresco automático de precios ---
# El servidor revisa los precios de Amazon por su cuenta y la web los actualiza
# sin recargar. Sin configurar nada ya funciona: 30 fichas cada 20 minutos y
# caducidad de 24 h. Para desactivarlo, PRICE_SYNC=0.
# PRICE_SYNC=1
# PRICE_SYNC_INTERVAL_MIN=20
# PRICE_SYNC_BATCH=30
# PRICE_SYNC_MAX_AGE_HOURS=24
# PRICE_SYNC_ADMIN_TOKEN=        # si se rellena, POST /api/prices/refresh pide x-admin-token

# --- Pagos (Stripe Checkout) ---
# Venta del informe técnico descargable. Sin clave, el botón de compra queda
# desactivado y el resto de la web funciona igual. Las claves de prueba (sk_test_)
# permiten probar el flujo completo con la tarjeta 4242 4242 4242 4242.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# REPORT_PRICE_CENTS=990
# REPORT_CURRENCY=eur
# REPORT_PRODUCT_NAME=Informe técnico PRO
# PUBLIC_BASE_URL=https://diagnostico-mecanica.onrender.com
# REPORT_ORDERS_PATH=./data/orders.json

# --- Motor de IA (opcional; sin clave se usa el motor experto local) ---
# Se elige un proveedor y se rellena su clave. Todos menos Gemini hablan el
# formato OpenAI, así que cambiar de servicio no requiere tocar código.
# Prioridad automática: AI_API_KEY > GROQ_API_KEY > OPENROUTER_API_KEY >
# MISTRAL_API_KEY > CEREBRAS_API_KEY > OPENAI_API_KEY > GEMINI_API_KEY.
# AI_PROVIDER=groq              # groq | openrouter | mistral | cerebras | openai | compatible | gemini
# AI_MODEL=openai/gpt-oss-120b  # Groq ya no sirve llama-3.3-70b-versatile
# AI_REASONING_EFFORT=low       # low reduce tokens de "pensamiento" (clave en capas gratuitas)
# AI_BASE_URL=https://api.groq.com/openai/v1   # solo para proveedores compatibles
# AI_API_KEY=                   # interruptor genérico para cualquier servicio compatible
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=               # proveedor alternativo heredado
# GEMINI_MODEL=gemini-3.8-flash
#
# Claves extra del mismo proveedor (cuentas gratuitas adicionales). Cada clave
# añade un eslabón independiente a la cadena: si una cuenta agota su cuota, la
# siguiente responde. Sirve cualquier proveedor de los de arriba.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# CEREBRAS_API_KEY_2=
# OPENROUTER_API_KEY_2=
#
# Presupuesto de la cadena: si ninguna IA responde a tiempo se devuelve el
# motor experto local al instante (la web nunca se queda colgada).
# AI_DEADLINE_MS=35000
# WEB_SEARCH_ENABLED=0         # 0 desactiva las búsquedas en foros y web
#
# Pollinations: último recurso gratuito y sin clave. Se usa solo si no hay
# proveedores configurados o si todos fallan. No admite imágenes y limita a una
# respuesta cada 45 s por IP (se respeta ese hueco para no hacer esperar).
# POLLINATIONS_ENABLED=1
# POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai-fast

# --- Visión (Reconocer testigos) ---
# El proveedor que analiza fotos puede ser distinto del de texto: así se chatea
# con un modelo rápido y se leen imágenes con uno multimodal. Si no se indica
# nada, se usa el proveedor de texto cuando acepta imágenes y, si no, Gemini.
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-3.5-flash-lite

# FORUM_DB_PATH=./data/forum.sqlite
# FORUM_UPLOAD_DIR=./data/forum/uploads
# TUTORIAL_DB_PATH=./data/tutorials.sqlite
# TUTORIAL_SEED_PATH=./data/tutorials-seed.json
# TUTORIAL_CATEGORIES_PATH=./data/tutorial-categories.json
# YOUTUBE_API_KEY=

# --- Copia de seguridad en la nube (imprescindible en Render Free) ---
# Render borra el disco en cada despliegue: sin esto se pierden las cuentas,
# los coches del garaje, los PDF/fotos y el foro. Con estas dos claves, al
# arrancar se restaura la última copia y cada minuto se sube lo nuevo a
# Supabase Storage (gratis: 1 GB, sin tarjeta).
# SUPABASE_URL=https://tuproyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (Project Settings → API → service_role)
# DB_BACKUP_BUCKET=mecanica-db
# DB_BACKUP_INTERVAL_MS=60000
# DB_BACKUP_DISABLED=1   (solo para pruebas locales)

# --- Publicación automática en redes (Upload-Post) ---
# Sube el vídeo de la app a TikTok, Instagram, Facebook y YouTube con una sola
# llamada. Upload-Post tiene las apps ya aprobadas por cada red, así que no hay
# que registrar aplicaciones ni pasar auditorías: solo conectar las cuentas una
# vez en su panel. Sin clave, `npm run redes:publicar` no envía nada.
# Plan: el gratuito permite 10 subidas al mes y no incluye TikTok; el de 24 $
# (16 $ anual) es ilimitado y sí incluye TikTok, Instagram, Facebook y YouTube.
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_USER=diagnostico-mecanica
# PUBLICAR_REDES=tiktok,instagram,facebook,youtube
# PUBLICAR_VIDEO=/home/selupiro/Escritorio/Diagnostico-Mecanica-TikTok.mp4
# PUBLICAR_TITULO=Diagnóstico y Mecánica: la app que te dice qué le pasa a tu coche
# PUBLICAR_DESCRIPCION=

# --- App Android (TWA) ---
# Huella SHA-256 de la firma del APK/AAB. El servidor la publica en
# /.well-known/assetlinks.json para que Android abra la app sin barra de
# direcciones. Admite varias huellas separadas por comas (upload key +
# App signing key de Play Console). Sin configurar, la web y la PWA siguen igual.
# ANDROID_PACKAGE_NAME=com.diagnosticomecanica.app
# ANDROID_SHA256_FINGERPRINT=AA:BB:CC:...


# --- Newsletter (Brevo) ---
# Envío de emails de bienvenida y tutoriales. Sin clave, la suscripción se guarda
# localmente pero no se envía email. Plan gratuito: 300 emails/día.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@diagnosticoymecanica.com
# BREVO_SENDER_NAME=Diagnóstico y Mecánica

# Ver API_CATALOGO.md. Todas opcionales: sin clave la app sigue funcionando.
# NUEVA IA gratuita (segunda cadena, OpenAI-compatible):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# SambaNova Cloud (free, sin tarjeta, 20 RPM/20 RPD por modelo):
# SAMBANOVA_API_KEY=
# NVIDIA NIM (free para prototipado, sin tarjeta):
# NVIDIA_API_KEY=
# Rutas reales (OpenRouteService, clave gratuita):
# OPENROUTESERVICE_API_KEY=
#
# Tráfico en vivo (TomTom + HERE, ambos gratuitos con registro):
# TomTom: 2.500 req/día gratis, excelente cobertura en España/Europa.
# HERE: 250.000 req/mes gratis, 70+ países.
# Con al menos una clave se activa la capa de tráfico en el GPS.
# TOMTOM_API_KEY=
# HERE_API_KEY=
# Meteorología con uso comercial permitido:
# WEATHERAPI_KEY=
# VISUALCROSSING_KEY=
# TTS de calidad (Google Cloud TTS; requiere billing habilitado):
# GOOGLE_CLOUD_TTS_KEY=
# TTS alternativo (Azure F0, 500K chars/mes):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# Búsqueda estructurada (Brave, 5 $/mes de crédito):
# BRAVE_SEARCH_API_KEY=
# Traducción (DeepL, 500K chars/mes):
# DEEPL_API_KEY=
# OCR alternativo sin tarjeta (OCR.space, solo registro):
# OCRSPACE_API_KEY=
# Cache de sesiones (Upstash Redis, free):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Base de datos alternativa (Turso, free):
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- Imágenes (Pexels, gratis, 200 req/h) ---
# Fotos de coches para las fichas de vehículos. Sin clave se usan placeholders.
# PEXELS_API_KEY=

# --- Google Search Console API (requiere service account JSON) ---
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SITE_URL=https://diagnosticoymecanica.com

# --- Google Analytics 4 Data API (requiere service account JSON) ---
# GA4_PROPERTY_ID=123456789
