[
  {"code":"P0300","title":"Fallos de encendido aleatorios/múltiples","description":"La ECU detecta combustiones irregulares en uno o varios cilindros.","system":"Motor","scope":"generic","severity":"media/alta","checks":[{"step":1,"text":"Leer contador de fallos y cilindros afectados."},{"step":2,"text":"Comprobar encendido o inyección según el tipo de motor."},{"step":3,"text":"Buscar entradas de aire y comprobar mezcla."},{"step":4,"text":"Verificar compresión si las comprobaciones anteriores no explican el fallo."}],"causes":[{"likelihood":"frecuente","text":"Encendido defectuoso o mezcla incorrecta"},{"likelihood":"frecuente","text":"Inyector con funcionamiento irregular"},{"likelihood":"posible","text":"Problema mecánico de compresión"}]},
  {"code":"P0301","title":"Fallo de encendido cilindro 1","description":"La ECU detecta un fallo de combustión en el cilindro 1.","system":"Motor","scope":"generic","severity":"media/alta","checks":[{"step":1,"text":"Comprobar bujía/bobina si el motor utiliza encendido por chispa."},{"step":2,"text":"Intercambiar el elemento de encendido con otro cilindro y observar si el fallo se desplaza."},{"step":3,"text":"Comprobar inyector y cableado."},{"step":4,"text":"Comprobar compresión si el fallo permanece en el cilindro."}],"causes":[{"likelihood":"frecuente","text":"Bujía o bobina"},{"likelihood":"frecuente","text":"Inyector"},{"likelihood":"posible","text":"Compresión insuficiente"}]},
  {"code":"P0171","title":"Mezcla demasiado pobre","description":"La gestión del motor detecta una corrección de mezcla hacia pobre.","system":"Motor / Combustible","scope":"generic","severity":"media","checks":[{"step":1,"text":"Buscar entradas de aire no medido."},{"step":2,"text":"Revisar MAF/MAP y datos en vivo."},{"step":3,"text":"Comprobar presión y suministro de combustible."},{"step":4,"text":"Revisar fugas de escape antes de sensores de oxígeno."}],"causes":[{"likelihood":"frecuente","text":"Entrada de aire no medido"},{"likelihood":"frecuente","text":"MAF/MAP con lectura incorrecta"},{"likelihood":"posible","text":"Presión de combustible insuficiente"}]},
  {"code":"P0299","title":"Presión de sobrealimentación insuficiente","description":"La presión de turbo medida queda por debajo de la esperada.","system":"Sobrealimentación","scope":"generic","severity":"media","checks":[{"step":1,"text":"Inspeccionar manguitos, intercooler y conexiones."},{"step":2,"text":"Comparar presión real y objetivo con diagnosis."},{"step":3,"text":"Comprobar actuador/geometría del turbo."},{"step":4,"text":"Revisar fugas de vacío o control electrónico según el sistema."}],"causes":[{"likelihood":"frecuente","text":"Fuga de aire"},{"likelihood":"frecuente","text":"Control de turbo defectuoso"},{"likelihood":"posible","text":"Turbo con problema mecánico"}]},
  {"code":"P0234","title":"Sobrealimentación excesiva","description":"La presión de turbo supera el valor esperado.","system":"Sobrealimentación","scope":"generic","severity":"alta","checks":[{"step":1,"text":"No exigir el motor hasta diagnosticar."},{"step":2,"text":"Comprobar actuador y control de geometría."},{"step":3,"text":"Revisar sensores y electroválvulas de control."},{"step":4,"text":"Comparar presión real/objetivo en datos en vivo."}],"causes":[{"likelihood":"frecuente","text":"Geometría variable agarrotada"},{"likelihood":"posible","text":"Actuador o control de turbo"},{"likelihood":"posible","text":"Sensor de presión"}]},
  {"code":"P0087","title":"Presión de combustible demasiado baja","description":"La presión de combustible está por debajo del umbral esperado.","system":"Combustible","scope":"generic","severity":"alta","checks":[{"step":1,"text":"Comparar presión solicitada y real."},{"step":2,"text":"Comprobar filtro y alimentación."},{"step":3,"text":"Comprobar bomba de baja/alta según el sistema."},{"step":4,"text":"Revisar fugas y control de presión."}],"causes":[{"likelihood":"frecuente","text":"Filtro de combustible obstruido"},{"likelihood":"posible","text":"Bomba de combustible"},{"likelihood":"posible","text":"Regulación de presión"}]},
  {"code":"P0101","title":"Rango/rendimiento del MAF","description":"La señal del caudalímetro no coincide con el funcionamiento esperado.","system":"Admisión","scope":"generic","severity":"media","checks":[{"step":1,"text":"Revisar admisión y posibles fugas."},{"step":2,"text":"Comprobar señal del MAF en datos en vivo."},{"step":3,"text":"Inspeccionar conector y cableado."},{"step":4,"text":"No sustituir el sensor sin confirmar la causa."}],"causes":[{"likelihood":"frecuente","text":"Fuga de admisión"},{"likelihood":"frecuente","text":"MAF contaminado o defectuoso"},{"likelihood":"posible","text":"Problema de cableado"}]},
  {"code":"P0401","title":"Flujo EGR insuficiente","description":"El flujo de recirculación de gases es inferior al esperado.","system":"EGR","scope":"generic","severity":"media","checks":[{"step":1,"text":"Comprobar mando de EGR."},{"step":2,"text":"Inspeccionar conductos y acumulación de carbonilla."},{"step":3,"text":"Comprobar sensores asociados."},{"step":4,"text":"Verificar funcionamiento con actuadores si la herramienta lo permite."}],"causes":[{"likelihood":"frecuente","text":"EGR o conductos obstruidos"},{"likelihood":"posible","text":"Actuador EGR"},{"likelihood":"posible","text":"Sensor de flujo/presión"}]},
  {"code":"P0420","title":"Eficiencia del catalizador por debajo del umbral","description":"La ECU observa una eficiencia calculada inferior al umbral.","system":"Escape","scope":"generic","severity":"media","checks":[{"step":1,"text":"Comprobar primero fallos de encendido o mezcla."},{"step":2,"text":"Revisar fugas de escape."},{"step":3,"text":"Analizar señales de sensores de oxígeno."},{"step":4,"text":"Valorar estado real del catalizador antes de sustituirlo."}],"causes":[{"likelihood":"frecuente","text":"Catalizador degradado"},{"likelihood":"posible","text":"Fallo de mezcla/encendido que lo ha deteriorado"},{"likelihood":"posible","text":"Fuga de escape"}]},
  {"code":"P0128","title":"Temperatura del refrigerante fuera de rango de calentamiento","description":"El motor tarda demasiado en alcanzar temperatura de servicio o la lectura no es la esperada.","system":"Refrigeración","scope":"generic","severity":"baja/media","checks":[{"step":1,"text":"Comprobar temperatura real frente a la indicada."},{"step":2,"text":"Revisar termostato."},{"step":3,"text":"Comprobar sensor y cableado."},{"step":4,"text":"Revisar nivel de refrigerante."}],"causes":[{"likelihood":"frecuente","text":"Termostato abierto"},{"likelihood":"posible","text":"Sensor de temperatura"},{"likelihood":"posible","text":"Nivel de refrigerante"}]},
  {"code":"P0480","title":"Circuito de control del ventilador 1","description":"La ECU detecta un problema en el mando del electroventilador.","system":"Refrigeración","scope":"generic","severity":"alta","checks":[{"step":1,"text":"Comprobar fusibles y alimentación."},{"step":2,"text":"Comprobar relé/módulo de control si existe."},{"step":3,"text":"Probar el ventilador."},{"step":4,"text":"Comprobar cableado y señal de mando."}],"causes":[{"likelihood":"frecuente","text":"Ventilador o alimentación"},{"likelihood":"posible","text":"Relé/módulo"},{"likelihood":"posible","text":"Cableado"}]},
  {"code":"P0530","title":"Sensor de presión del refrigerante A/C","description":"Problema detectado en la señal del sensor de presión del aire acondicionado.","system":"Climatización","scope":"generic","severity":"baja","checks":[{"step":1,"text":"Leer presión con equipo adecuado."},{"step":2,"text":"Comprobar sensor y conector."},{"step":3,"text":"Buscar fugas del circuito."},{"step":4,"text":"Verificar mando del compresor."}],"causes":[{"likelihood":"posible","text":"Sensor de presión"},{"likelihood":"posible","text":"Fuga o carga incorrecta"},{"likelihood":"posible","text":"Cableado"}]},
  {"code":"C0035","title":"Circuito/sensor de velocidad de rueda","description":"El sistema ABS detecta una anomalía en una señal de velocidad de rueda.","system":"ABS/ESP","scope":"generic","severity":"alta","checks":[{"step":1,"text":"Leer datos de las cuatro ruedas."},{"step":2,"text":"Inspeccionar sensor y cableado."},{"step":3,"text":"Revisar corona magnética/rodamiento."},{"step":4,"text":"Comprobar alimentación y señal."}],"causes":[{"likelihood":"frecuente","text":"Sensor de rueda"},{"likelihood":"posible","text":"Cableado/conector"},{"likelihood":"posible","text":"Corona o rodamiento"}]},
  {"code":"U0100","title":"Pérdida de comunicación con ECM/PCM","description":"Una unidad detecta pérdida de comunicación con el módulo de motor.","system":"Red CAN / Electrónica","scope":"generic","severity":"alta","checks":[{"step":1,"text":"Comprobar tensión de batería."},{"step":2,"text":"Revisar masas y alimentación de módulos."},{"step":3,"text":"Buscar otros códigos de comunicación."},{"step":4,"text":"Comprobar red CAN y conectores si procede."}],"causes":[{"likelihood":"frecuente","text":"Tensión de alimentación insuficiente"},{"likelihood":"posible","text":"Problema de red CAN"},{"likelihood":"posible","text":"Módulo o alimentación"}]},
  {"code":"U0121","title":"Pérdida de comunicación con módulo ABS","description":"Existe una pérdida de comunicación con el módulo de frenos ABS/ESP.","system":"ABS/ESP / Red CAN","scope":"generic","severity":"alta","checks":[{"step":1,"text":"Comprobar batería y alimentación."},{"step":2,"text":"Revisar fusibles y masas del módulo ABS."},{"step":3,"text":"Buscar códigos adicionales."},{"step":4,"text":"Comprobar cableado/red CAN si procede."}],"causes":[{"likelihood":"frecuente","text":"Alimentación o masa"},{"likelihood":"posible","text":"Cableado CAN"},{"likelihood":"posible","text":"Módulo ABS"}]},
  {"code":"B1000","title":"Fallo genérico de módulo de carrocería/seguridad","description":"Código dependiente del fabricante; requiere consultar la definición específica del vehículo.","system":"Carrocería / Seguridad","scope":"manufacturer","severity":"variable","checks":[{"step":1,"text":"Identificar marca, modelo, año y módulo que registra el código."},{"step":2,"text":"Consultar la definición específica del fabricante."},{"step":3,"text":"Comprobar alimentación, masas y conectores."}],"causes":[{"likelihood":"variable","text":"Depende de fabricante y módulo"}]}
]
